datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String         @id @default(uuid())
  phone               String         @unique
  email               String?        @unique
  emailVerified       Boolean        @default(false)
  passwordHash        String
  role                String         @default("user") // "user", "admin", "moderator"
  status              String         @default("active") // "active", "locked", "banned"
  lastLoginAt         DateTime?
  failedLoginAttempts Int            @default(0)
  lockoutUntil        DateTime?
  
  onboardingStep      String         @default("start") // "start", "profile", "preferences", "photos", "complete"
  onboardingComplete  Boolean        @default(false)
  deactivatedAt       DateTime?
  deletedAt           DateTime?

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  profile             Profile?
  preferences         Preference?
  settings            Setting?
  refreshTokens       RefreshToken[]
  discoveryMetrics    DiscoveryMetric[]
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  code      String
  type      String   @default("verification") // "verification", "password_reset"
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, type])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  deviceId  String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model LoginAttempt {
  id         String   @id @default(uuid())
  identifier String
  ipAddress  String
  successful Boolean
  reason     String?
  timestamp   DateTime @default(now())
}

model DiscoveryMetric {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String   // "requested", "served", "viewed", "skipped"
  targetId   String?  // The candidate ID if applicable
  cacheHit   Boolean  @default(false)
  timestamp  DateTime @default(now())
}

model SecurityAudit {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  ipAddress String?
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Profile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  age                 Int
  gender              String   // "male", "female", "non-binary"
  preference          String   // "male", "female", "everyone" (deprecated, moved to Preference model, but kept for compatibility)
  bio                 String?
  occupation          String?
  education           String?
  company             String?
  height              Int?     // in cm
  languages           String[] // Array of strings
  interests           String[] // Array of strings
  relationshipGoals   String?
  lifestyle           String?
  hometown            String?
  currentCity         String?
  latitude            Float?   // Optional now to allow onboarding without location immediately
  longitude           Float?
  elo                 Int      @default(1200)
  completionScore     Int      @default(0) // 0-100
  profileQualityScore Int      @default(0) // 0-100
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  photos              Photo[]
}

model Preference {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredGender      String   @default("everyone") // "male", "female", "everyone"
  minAge               Int      @default(18)
  maxAge               Int      @default(99)
  maxDistance          Int      @default(50) // in miles or km
  relationshipType     String?
  lifestylePreferences String[]
  visibility           String   @default("public") // "public", "hidden"
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Setting {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  showOnlineStatus Boolean  @default(true)
  showDistance     Boolean  @default(true)
  showAge          Boolean  @default(true)
  incognitoMode    Boolean  @default(false)
  privacySettings  String?  // JSON string or structured field for extra privacy toggles
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Photo {
  id           String             @id @default(uuid())
  profileId    String
  profile      Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  url          String
  key          String?            // Storage provider key
  isPrimary    Boolean            @default(false)
  blurHash     String?
  order        Int                @default(0)
  size         Int?
  mimeType     String?
  verification PhotoVerification?
  createdAt    DateTime           @default(now())
}

model PhotoVerification {
  id                  String   @id @default(uuid())
  photoId             String   @unique
  photo               Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  status              String   @default("pending") // pending, approved, rejected, manual_review
  trustScore          Int?     // 0-100
  faceCount           Int?
  qualityScore        Int?     // 0-100
  blurScore           Int?     // 0-100
  brightnessScore     Int?     // 0-100
  aiProbability       Float?   // 0.0 - 1.0
  nsfwScore           Float?   // 0.0 - 1.0
  violenceScore       Float?   // 0.0 - 1.0
  watermarkScore      Float?   // 0.0 - 1.0
  duplicateScore      Float?   // 0.0 - 1.0
  embeddingReference  String?  // UUID referencing vector db or raw embedding
  modelVersions       String?  // JSON string tracing AI models used
  providerName        String?  // Identity of the AI Provider (e.g. 'mock', 'aws', 'google')
  executionTimeMs     Int?     // Execution time in milliseconds
  failureReasons      String[] // Array of rejection reasons
  verificationTime    DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Swipe {
  id        String   @id @default(uuid())
  swiperId  String
  targetId  String
  rating    String   // "LIKE", "PASS", "SUPER_LIKE", "BOOST", "REWIND"
  createdAt DateTime @default(now())

  @@unique([swiperId, targetId])
  @@index([swiperId])
  @@index([targetId])
}

model Match {
  id        String   @id @default(uuid())
  user1Id   String
  user2Id   String
  metadata  MatchMetadata?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([user1Id])
  @@index([user2Id])
  @@unique([user1Id, user2Id])
}

model MatchMetadata {
  id                 String   @id @default(uuid())
  matchId            String   @unique
  match              Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  compatibilityScore Float?   // Calculated upon match
  trustScoreAvg      Float?
  distance           Float?
  interestSimilarity Float?
  eloDifference      Int?
  createdAt          DateTime @default(now())
}

model Relationship {
  id        String   @id @default(uuid())
  user1Id   String   // Convention: lower UUID first for uniqueness without duplicating
  user2Id   String
  status    String   // "UNKNOWN", "VIEWED", "LIKED", "PASSED", "MATCHED", "BLOCKED", "REPORTED"
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model InteractionHistory {
  id        String   @id @default(uuid())
  actorId   String
  targetId  String
  action    String   // "SWIPE_LIKE", "SWIPE_PASS", "BLOCK", "REPORT", "VIEW"
  metadata  String?  // JSON context (latency, rule triggers)
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetId])
  @@index([action])
}

model Conversation {
  id            String         @id @default(uuid())
  matchId       String?        @unique // Optional if a conversation isn't strictly tied to a match (e.g. support chat)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastMessageId String?
  participants  Participant[]
  messages      Message[]
}

model Participant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  isArchived     Boolean      @default(false)
  isPinned       Boolean      @default(false)
  isMuted        Boolean      @default(false)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String         @id @default(uuid())
  conversationId String
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  type           String         @default("TEXT") // "TEXT", "IMAGE", "VOICE", "VIDEO", "LOCATION"
  content        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  attachments    Attachment[]
  statuses       MessageStatus[]

  @@index([conversationId])
  @@index([createdAt])
  @@index([senderId])
}

model Attachment {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url       String
  type      String   // "IMAGE", "VIDEO", "DOCUMENT", "VOICE"
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())
}

model MessageStatus {
  id          String   @id @default(uuid())
  messageId   String
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId      String   // The recipient whose status this represents
  status      String   // "SENT", "DELIVERED", "READ", "FAILED"
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId, status])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

model Mute {
  id        String   @id @default(uuid())
  muterId   String
  mutedId   String
  createdAt DateTime @default(now())

  @@unique([muterId, mutedId])
  @@index([muterId])
}

model Report {
  id            String   @id @default(uuid())
  reporterId    String
  reportedId    String
  targetType    String   // "USER", "MESSAGE", "PROFILE", "PHOTO", "CONVERSATION", "MATCH"
  targetId      String?
  reasonCategory String  // e.g. "SPAM", "HARASSMENT", "INAPPROPRIATE"
  customReason  String?
  status        String   @default("PENDING") // PENDING, REVIEWING, RESOLVED, DISMISSED
  evidenceUrls  String[]
  caseId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([reportedId])
  @@index([reporterId])
  @@index([status])
}

model Appeal {
  id            String   @id @default(uuid())
  userId        String
  restrictionId String
  reason        String
  evidenceUrls  String[]
  status        String   @default("PENDING") // PENDING, REVIEWING, APPROVED, REJECTED
  moderatorId   String?
  moderatorNote String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model ModerationCase {
  id          String   @id @default(uuid())
  userId      String
  trigger     String   // "USER_REPORT", "AI_FLAG", "RISK_SCORE"
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, CLOSED
  severity    String   // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model RiskAssessment {
  id                    String   @id @default(uuid())
  userId                String   @unique
  spamRisk              Float    @default(0.0)
  fraudRisk             Float    @default(0.0)
  scamRisk              Float    @default(0.0)
  botProbability        Float    @default(0.0)
  fakeProfileProbability Float    @default(0.0)
  messageAbuseScore     Float    @default(0.0)
  overallRiskScore      Float    @default(0.0)
  aiConfidence          Float?
  lastEvaluatedAt       DateTime @default(now())

  @@index([overallRiskScore])
}

model Reputation {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  trustScore             Int      @default(100) // 0-100
  safetyScore            Int      @default(100)
  reportCount            Int      @default(0)
  verifiedSignals        Int      @default(0)
  positiveBehaviourScore Int      @default(0)
  negativeBehaviourScore Int      @default(0)
  updatedAt              DateTime @updatedAt
}

model Restriction {
  id          String   @id @default(uuid())
  userId      String
  type        String   // "WARNING", "SHADOW_BAN", "TEMPORARY_SUSPENSION", "PERMANENT_BAN"
  reason      String
  active      Boolean  @default(true)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([active])
}

model AuditEvent {
  id           String   @id @default(uuid())
  actorId      String?  // SYSTEM or Moderator ID
  targetId     String   // The affected user/entity
  action       String   // "RESTRICTION_APPLIED", "CASE_RESOLVED"
  prevState    String?  // JSON string
  newState     String?  // JSON string
  reason       String?
  aiConfidence Float?
  createdAt    DateTime @default(now())

  @@index([targetId])
  @@index([action])
}

model ModeratorAction {
  id          String   @id @default(uuid())
  moderatorId String
  caseId      String?
  action      String
  notes       String?
  createdAt   DateTime @default(now())

  @@index([moderatorId])
  @@index([caseId])
}

model Plan {
  id            String         @id @default(uuid())
  name          String
  level         Int            @default(0) // 0=Free, 1=Premium, 2=Gold, etc.
  price         Float
  currency      String         @default("USD")
  interval      String         @default("month") // month, year
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id                     String        @id @default(uuid())
  userId                 String
  planId                 String
  plan                   Plan          @relation(fields: [planId], references: [id])
  status                 String        @default("active") // active, trialing, past_due, canceled, unpaid
  provider               String        @default("mock") // stripe, apple, google
  providerSubscriptionId String?
  currentPeriodStart     DateTime      @default(now())
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean       @default(false)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  entitlements           Entitlement[]
  purchases              Purchase[]

  @@index([userId])
  @@index([status])
}

model Feature {
  id           String        @id @default(uuid())
  name         String
  key          String        @unique // e.g. "unlimited_swipes", "super_likes"
  description  String?
  entitlements Entitlement[]
}

model Entitlement {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  featureId      String
  feature        Feature      @relation(fields: [featureId], references: [id], onDelete: Cascade)
  active         Boolean      @default(true)
  expiresAt      DateTime?
  
  @@unique([subscriptionId, featureId])
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  rules       String?  // JSON containing percentage rollouts, user targeting
  environment String   @default("production")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Experiment {
  id        String              @id @default(uuid())
  key       String              @unique
  name      String
  status    String              @default("DRAFT") // DRAFT, RUNNING, COMPLETED
  variants  ExperimentVariant[]
  createdAt DateTime            @default(now())
}

model ExperimentVariant {
  id           String     @id @default(uuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  key          String
  weight       Int        @default(1) // Relative weight for traffic allocation
}

model Promotion {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String    // "PERCENTAGE", "FIXED", "TRIAL"
  discountValue Float
  maxUses       Int?
  uses          Int       @default(0)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  coupons       Coupon[]
}

model Coupon {
  id          String    @id @default(uuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  userId      String
  redeemedAt  DateTime  @default(now())

  @@index([userId])
}

model Referral {
  id            String   @id @default(uuid())
  referrerId    String
  refereeId     String   @unique
  status        String   @default("PENDING") // PENDING, COMPLETED, FRAUD
  rewardGranted Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([referrerId])
}

model Reward {
  id          String   @id @default(uuid())
  userId      String
  type        String   // "COINS", "BOOST", "SUPER_LIKE", "PREMIUM_DAYS"
  amount      Int      @default(1)
  status      String   @default("GRANTED") // GRANTED, REDEEMED, EXPIRED
  createdAt   DateTime @default(now())
  redeemedAt  DateTime?

  @@index([userId])
  @@index([status])
}

model Achievement {
  id          String                @id @default(uuid())
  key         String                @unique
  name        String
  description String
  criteria    String                // JSON rules
  progresses  AchievementProgress[]
}

model AchievementProgress {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  progress      Int         @default(0)
  completedAt   DateTime?
  
  @@unique([userId, achievementId])
}

model Purchase {
  id                    String        @id @default(uuid())
  userId                String
  subscriptionId        String?
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amount                Float
  currency              String        @default("USD")
  status                String        @default("PENDING") // PENDING, SUCCESS, FAILED, REFUNDED
  providerTransactionId String?       @unique
  createdAt             DateTime      @default(now())
  invoices              Invoice[]

  @@index([userId])
}

model Invoice {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  url        String?
  createdAt  DateTime @default(now())
}

model BillingEvent {
  id              String   @id @default(uuid())
  type            String   // "PAYMENT_SUCCESS", "SUBSCRIPTION_CANCELED", "CHARGEBACK"
  providerEventId String?  @unique
  payload         String?  // Raw webhook payload
  processedAt     DateTime @default(now())
}

model PromptTemplate {
  id          String          @id @default(uuid())
  key         String          @unique
  name        String
  category    String
  template    String
  metadata    String?
  versions    PromptVersion[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model PromptVersion {
  id         String         @id @default(uuid())
  templateId String
  template   PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version    Int
  content    String
  active     Boolean        @default(false)
  createdAt  DateTime       @default(now())
}

model AIRequest {
  id            String      @id @default(uuid())
  userId        String?
  provider      String
  model         String
  category      String
  promptTokens  Int         @default(0)
  responseTokens Int        @default(0)
  costUsd       Float       @default(0.0)
  latencyMs     Int         @default(0)
  status        String      @default("SUCCESS")
  response      AIResponse?
  createdAt     DateTime    @default(now())

  @@index([userId])
  @@index([provider])
  @@index([category])
}

model AIResponse {
  id          String    @id @default(uuid())
  requestId   String    @unique
  request     AIRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  content     String
  metadata    String?
  createdAt   DateTime  @default(now())
}

model Embedding {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  vector      String
  model       String   @default("mock-embed-v1")
  dimensions  Int      @default(384)
  createdAt   DateTime @default(now())

  @@unique([entityType, entityId])
  @@index([entityType])
}

model CompatibilityProfile {
  id                      String   @id @default(uuid())
  user1Id                 String
  user2Id                 String
  overallScore            Int
  interestScore           Int?
  lifestyleScore          Int?
  conversationScore       Int?
  relationshipGoalScore   Int?
  explanation             String?
  suggestions             String?
  generatedAt             DateTime @default(now())

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model RelationshipMemory {
  id              String   @id @default(uuid())
  matchId         String   @unique
  user1Id         String
  user2Id         String
  sharedTopics    String[]
  sharedInterests String[]
  importantEvents String?
  highlights      String?
  summary         String?
  suggestions     String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

model ConversationSummary {
  id              String   @id @default(uuid())
  conversationId  String   @unique
  summary         String
  topics          String[]
  tone            String?
  momentum        String?
  messageCount    Int      @default(0)
  generatedAt     DateTime @default(now())
}

model AIUsage {
  id            String   @id @default(uuid())
  userId        String?
  provider      String
  model         String
  category      String
  tokens        Int      @default(0)
  costUsd       Float    @default(0.0)
  period        String
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([provider])
  @@index([period])
}

model AIAudit {
  id            String   @id @default(uuid())
  requestId     String?
  userId        String?
  action        String
  details       String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([action])
}

model OpsAudit {
  id          String   @id @default(uuid())
  adminId     String
  action      String
  entityType  String
  entityId    String?
  oldValue    String?
  newValue    String?
  reason      String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([entityType])
}

model Incident {
  id          String   @id @default(uuid())
  title       String
  description String
  status      String   @default("OPEN") // OPEN, INVESTIGATING, RESOLVED
  severity    String   // LOW, MEDIUM, HIGH, CRITICAL
  ownerId     String?
  rca         String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OpsMetric {
  id          String   @id @default(uuid())
  category    String
  name        String
  value       Float
  tags        String?
  recordedAt  DateTime @default(now())

  @@index([category, name, recordedAt])
}
